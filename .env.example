# Copy to .env.local for local development, and add the same variables in
# Vercel -> Project -> Settings -> Environment Variables for production.
# NEVER commit real values. Only the two NEXT_PUBLIC_ ones are visible to
# the browser; everything else stays on the server.

# --- Supabase (Project Settings -> API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design (it ships in your site's JavaScript). After the
# security lockdown it can only READ public content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-only. Bypasses all database security — it is what your
# admin API routes use to write. Never prefix with NEXT_PUBLIC_, never
# paste it into client code, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---------------------------------------------------------
# Username for the admin panel (case-insensitive). Defaults to "qasim" if unset.
ADMIN_USERNAME=

# RECOMMENDED: a scrypt hash of your password, so the real password is never
# stored anywhere. Generate it (the password is typed hidden, never echoed):
#     node scripts/admin-setup.mjs hash
# then delete ADMIN_PASSWORD below.
ADMIN_PASSWORD_HASH=

# LEGACY: plain-text password. Still works so existing deployments don't
# break, but is ignored once ADMIN_PASSWORD_HASH is set. There is
# deliberately NO default — if neither is set, admin login is refused.
ADMIN_PASSWORD=

# OPTIONAL two-factor login (a 6-digit code from an authenticator app).
# Turn it on by generating a secret:   node scripts/admin-setup.mjs totp
# Leave empty to keep 2FA off.
ADMIN_TOTP_SECRET=

# Display name / email attached to the admin session (cosmetic)
ADMIN_NAME=
ADMIN_EMAIL=

# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# http://localhost:3000 locally, your real https domain in production
NEXTAUTH_URL=http://localhost:3000

# --- Email (Resend) — optional but needed for order/newsletter/contact mail
RESEND_API_KEY=
# Where contact-form and new-order notifications are sent (your inbox)
NOTIFY_TO_EMAIL=

# ---- AI assistant (optional) -------------------------------------------------
# Set ONE of these and an "Ask about me" chat appears on the site. It answers only from your site's
# content and is limited to 20 questions per visitor per hour. Leave both empty to hide it.
# Free: a Gemini key from aistudio.google.com/apikey (free tier; Google may use free-tier requests to
# improve its models). Paid: a Claude key from console.anthropic.com (used if both are set).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
